    <string name="settings_ai_key_set">Збережено на цьому пристрої</string>
    <string name="settings_ai_key_none">Не задано</string>
    <string name="settings_ai_key_note">Ключ зберігається в зашифрованому вигляді на цьому телефоні й надсилається лише в OpenRouter.</string>
    <string name="settings_ai_key_invalid">Це не схоже на ключ API</string>
