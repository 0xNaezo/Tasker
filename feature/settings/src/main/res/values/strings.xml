    <string name="onboarding_hours_title">When do you work?</string>
    <string name="onboarding_hours_body">The day\'s plan fits into these hours, with a buffer for the unexpected. You can change this any time in settings.</string>
    <string name="onboarding_plan_question">Send the day\'s plan at %1$s?</string>
    <string name="onboarding_plan_note">One short notification with the plan. You can turn it off in settings.</string>
    <string name="onboarding_calendar_title">Plan around your meetings</string>
    <string name="onboarding_calendar_body">With calendar access, time taken by events is subtracted from the day\'s capacity. Only the start and end of events are read, and they stay on the phone.</string>
    <string name="onboarding_calendar_allow">Allow access</string>
    <string name="onboarding_calendar_granted">Access granted. Busy time will be counted in the plan.</string>
    <string name="onboarding_calendar_denied">Without access, capacity is counted from working hours only. You can allow it later in system settings.</string>
    <string name="onboarding_task_title">Add your first task</string>
    <string name="onboarding_task_body">Write it the way you would say it: “call the bank tomorrow”, “report by Friday 18:00 #work”. Dates, deadlines, projects and tags are recognised as you type.</string>
    <string name="settings_ai">AI help</string>
    <string name="settings_ai_switch">AI help</string>
    <string name="settings_ai_intro">AI can estimate the size of a task and catch dates the rules missed. Typing never waits for it: fields are filled in the background, marked, and undone in one tap. Your own edits always win.</string>
    <string name="settings_ai_unavailable">Not available in this build</string>
    <string name="settings_ai_not_set_up">Off until you agree</string>
    <string name="settings_ai_off">Off. Fields AI already filled keep their mark.</string>
    <string name="settings_ai_on">On: sizes and dates are filled in the background</string>
