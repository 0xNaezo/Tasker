<configuration>
    <!--
        Logs go to stdout for the PaaS log drain. They never contain request or response bodies, headers or
        install ids (tech plan §18.1): the access log carries route, status, latency, tokens and cost only.
        Alert lines start with "ALERT " (logger app.tasker.backend.alerts).
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSX, UTC} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
